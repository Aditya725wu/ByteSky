map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name bytesky-app.duckdns.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bytesky-app.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/bytesky-app.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bytesky-app.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 100m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;

    location = /apache {
        return 301 /apache/;
    }

    location /apache/ {
        proxy_pass http://127.0.0.1:8088/;
        proxy_set_header X-Forwarded-Prefix /apache;
    }

    location = /jenkins {
        return 301 /jenkins/;
    }

    location /jenkins/ {
        proxy_pass http://127.0.0.1:8081/jenkins/;
        proxy_set_header X-Forwarded-Prefix /jenkins;
        proxy_redirect http://127.0.0.1:8081/jenkins/ /jenkins/;
        proxy_redirect http://localhost:8081/jenkins/ /jenkins/;
    }

    location = /metabase {
        return 301 /metabase/;
    }

    location /metabase/ {
        proxy_pass http://127.0.0.1:3005/;
        proxy_set_header X-Forwarded-Prefix /metabase;
    }

    location = /vm {
        return 301 /vm/;
    }

    location /vm/ {
        proxy_pass http://127.0.0.1:6080/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Prefix /vm;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
