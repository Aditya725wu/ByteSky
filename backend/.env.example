NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/bytesky
JWT_SECRET=replace_this_in_production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:80,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
REDIS_URL=redis://redis:6379
TRUST_PROXY=true
LOG_LEVEL=info
ADMIN_SEED_EMAIL=admin@bytesky.cloud
ADMIN_SEED_PASSWORD=ChangeMeImmediately!
ADMIN_SEED_NAME=System Administrator
METRICS_ENABLED=true
METRICS_INTERVAL_MS=5000
DOCKER_COMMAND=docker
CONTAINER_IMAGE=nginx:alpine
CONTAINER_INTERNAL_PORT=80
CONTAINER_PUBLIC_BASE_URL=http://localhost
CONTAINER_PORT_RANGE_START=3001
CONTAINER_PORT_RANGE_END=3099
MAX_CONTAINERS_PER_USER=1
CONTAINER_TTL_MS=1800000
DOCKER_SOCKET_PATH=/var/run/docker.sock
VM_IMAGE=ubuntu:22.04
VM_INTERNAL_PORT=80
VM_PUBLIC_BASE_URL=http://localhost
VM_PORT_RANGE_START=6001
VM_PORT_RANGE_END=6099
VM_TTL_MS=1800000
VM_MEMORY_MB=256
VM_CPU_LIMIT=0.5
APP_BASE_URL=http://localhost
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_CURRENCY=usd
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
